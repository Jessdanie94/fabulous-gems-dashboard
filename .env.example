SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=https://your-app-url.example.com
SCOPES=read_orders,read_products,read_finances
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_TOKEN=your_shopify_admin_access_token_here
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token_here
SHOPIFY_LOCATION_ID=your_shopify_location_id_here
SELLVIA_MASTER_KEY=your_sellvia_master_key_here
SELLVIA_API_KEY=your_sellvia_api_key_here
SELLVIA_API_BASE_URL=https://api.sellvia.com
SELLVIA_PRODUCTS_URL=https://sellvia.example.com/catalog/products
SELLVIA_INVENTORY_URL=https://sellvia.example.com/catalog/inventory
SELLVIA_PRICES_URL=https://sellvia.example.com/catalog/prices
SELLVIA_ORDERS_URL=https://sellvia.example.com/orders
SYNC_DRY_RUN=true
SYNC_SCOPE=catalog,inventory,price
SYNC_ENABLE_WRITES=false
SYNC_ENABLE_PRICE_WRITES=false
SYNC_ENABLE_INVENTORY_WRITES=false
SYNC_ENABLE_ORDER_WRITES=false
SYNC_APPROVE_BULK_CHANGES=false
SYNC_FAILURE_WEBHOOK_URL=https://hooks.example.com/services/replace-me

# --- Background workers (see docs/BACKGROUND_WORKERS.md) ---
# Master switch. Nothing runs unless this is true.
BACKGROUND_WORKERS_ENABLED=false
# Host workers inside server.js instead of `npm run workers` (also requires the master switch).
WORKERS_IN_PROCESS=false
WORKERS_SHUTDOWN_TIMEOUT_MS=15000
WORKER_INITIAL_JITTER_MS=30000
WORKER_MAX_BACKOFF_MS=21600000
WORKER_ALERT_COOLDOWN_MS=3600000
# Flagship public storefront (NOT the *.myshopify.com Admin domain in SHOPIFY_STORE_DOMAIN)
STORE_DOMAIN=fabulousgemsparlor.store
# Defaults to https://${STORE_DOMAIN}/collections/all.atom
STORE_RSS_URL=https://fabulousgemsparlor.store/collections/all.atom
# Token/credential health check
WORKER_TOKEN_HEALTH_ENABLED=true
WORKER_TOKEN_HEALTH_INTERVAL_MS=900000
WORKER_SESSION_EXPIRY_WARN_MS=86400000
# Catalog/inventory/price sync (off by default: the GitHub Action already schedules it).
# Writes need BOTH WORKER_SYNC_DRY_RUN=false and SYNC_DRY_RUN=false plus the SYNC_ENABLE_* flags.
WORKER_SYNC_ENABLED=false
WORKER_SYNC_INTERVAL_MS=3600000
WORKER_SYNC_DRY_RUN=true
# WORKER_SYNC_SCOPE=catalog,inventory,price
# Webhook retry / dead-letter
WORKER_WEBHOOK_RETRY_ENABLED=true
WORKER_WEBHOOK_RETRY_INTERVAL_MS=120000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_MS=60000
WEBHOOK_RETRY_MAX_MS=3600000
WEBHOOK_RETRY_BATCH_SIZE=25
# Store drift reconciliation (read-only)
WORKER_DRIFT_ENABLED=true
WORKER_DRIFT_INTERVAL_MS=14400000
SYNC_STALE_AFTER_MS=10800000
WORKER_DRIFT_FEED_CHECK_ENABLED=true
# Housekeeping
WORKER_HOUSEKEEPING_ENABLED=true
WORKER_HOUSEKEEPING_INTERVAL_MS=86400000
RETENTION_ARTIFACTS_DAYS=14
RETENTION_WEBHOOK_DAYS=30
