# =====================================================================
# Fabulous Gems Dashboard — environment template
# Copy to .env and fill in. NEVER commit real values (.env is gitignored).
# =====================================================================

# --- Shopify app (Partners dashboard → App → Client credentials) ---
SHOPIFY_API_KEY=your_shopify_client_id_here
SHOPIFY_API_SECRET=your_shopify_client_secret_here
SHOPIFY_APP_URL=https://fabulousgemsparlor-store.onrender.com
SCOPES=read_orders,write_orders,read_products,read_finances,read_inventory
# Optional: custom shop domain for embedded auth
SHOP_CUSTOM_DOMAIN=

# --- Store Admin API access (Shopify Admin → Apps → Develop apps) ---
# SHOPIFY_STORE_URL / SHOPIFY_STORE_DOMAIN / SHOPIFY_STORE1_DOMAIN are aliases (first set wins)
SHOPIFY_STORE_URL=fabulousgemsparlor.myshopify.com
SHOPIFY_STORE_DOMAIN=fabulousgemsparlor.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN / SHOPIFY_ACCESS_TOKEN / SHOPIFY_STORE1_TOKEN / SHOPIFY_API_TOKEN are aliases
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_token_here
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_LOCATION_ID=your_shopify_location_id_here
# Webhook HMAC secret (the custom app's "API secret key"). Falls back to SHOPIFY_API_SECRET.
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Legacy multi-store diagnostic scripts (check-stores.cjs, who-charged-me.cjs)
SHOPIFY_STORE1_DOMAIN=
SHOPIFY_STORE1_TOKEN=
SHOPIFY_STORE2_DOMAIN=
SHOPIFY_STORE2_TOKEN=
SHOPIFY_STORE3_DOMAIN=
SHOPIFY_STORE3_TOKEN=

# --- Sellvia ---
# NOTE: api.sellvia.com does not currently resolve (NXDOMAIN). Set the real base URL once confirmed with Sellvia.
SELLVIA_API_BASE_URL=https://api.sellvia.com
SELLVIA_API_KEY=your_sellvia_api_key_here
SELLVIA_MASTER_KEY=your_sellvia_master_key_here
SELLVIA_STORE_ID=your_sellvia_store_id_here
SELLVIA_PRODUCTS_URL=https://sellvia.example.com/catalog/products
SELLVIA_INVENTORY_URL=https://sellvia.example.com/catalog/inventory
SELLVIA_PRICES_URL=https://sellvia.example.com/catalog/prices
SELLVIA_ORDERS_URL=https://sellvia.example.com/orders

# --- Internal endpoint protection ---
# Shared secret required in the X-Cron-Secret header for POST /api/circuit-breaker
CRON_SECRET=generate_a_long_random_string

# --- Sync engine safety switches (src/shopify-sellvia-sync.js) ---
SYNC_DRY_RUN=true
SYNC_SCOPE=catalog,inventory,price
SYNC_ENABLE_WRITES=false
SYNC_ENABLE_PRICE_WRITES=false
SYNC_ENABLE_INVENTORY_WRITES=false
SYNC_ENABLE_ORDER_WRITES=false
SYNC_APPROVE_BULK_CHANGES=false
SYNC_FAILURE_WEBHOOK_URL=

# --- Database (note: prisma/schema.prisma currently hardcodes file:dev.sqlite) ---
DATABASE_URL=file:./dev.sqlite
