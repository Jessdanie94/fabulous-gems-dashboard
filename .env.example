SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=https://your-app-url.example.com
SCOPES=read_orders,read_products,read_finances

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token_here
SHOPIFY_API_TOKEN=your_shopify_admin_access_token_here

SELLVIA_MASTER_KEY=your_sellvia_readonly_api_key_here
SELLVIA_API_KEY=your_sellvia_readonly_api_key_here
SELLVIA_RECONCILIATION_URL=https://api.sellvia.com/analytics/reconciliation

RECON_SOURCE=shopify-only
RECON_DRY_RUN=true
RECON_START_DATE=2026-01-01
RECON_END_DATE=2026-01-31
RECON_MATCH_WINDOW_DAYS=3
RECON_MAX_RETRIES=3
RECON_TIMEOUT_MS=15000
RECON_BACKOFF_MS=1000
RECON_ARTIFACTS_DIR=artifacts/reconciliation-sync

# Optional local fixture files for dry-runs/tests.
SHOPIFY_PAYOUTS_FILE=/tmp/reconciliation/shopify-payouts.json
SHOPIFY_ORDERS_FILE=/tmp/reconciliation/shopify-orders.json
SHOPIFY_TRANSACTIONS_FILE=/tmp/reconciliation/shopify-transactions.json
SELLVIA_RECONCILIATION_FILE=/tmp/reconciliation/sellvia-reconciliation.json

# NEVER store bank account/routing details in .env, GitHub secrets, logs, artifacts, or repository files.
