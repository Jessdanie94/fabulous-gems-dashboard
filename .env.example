# Shopify App credentials (from Partners dashboard → App → API credentials)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=https://fabulousgemsparlor-store.onrender.com
SCOPES=read_orders,write_orders,read_products,read_finances

# Store admin access (fabulousgemsparlor.store only)
# Generate in Shopify Admin → Apps → Develop apps → your app → API credentials
SHOPIFY_STORE_DOMAIN=fabulousgemsparlor.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_token_here

# Sellvia inventory sync key (used by GitHub Actions workflow for stock updates)
# Generate in Sellvia dashboard → Settings → API → Inventory Access
SELLVIA_API_KEY=your_sellvia_api_key_here

# Sellvia analytics key (used by sellvia.server.ts for dashboard revenue/orders panel)
# Generate in Sellvia dashboard → Settings → API → Analytics Access
SELLVIA_MASTER_KEY=your_sellvia_master_key_here

# Database
DATABASE_URL=file:./dev.db
