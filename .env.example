SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-url.example.com
SCOPES=read_orders,read_products,read_finances

# Sync runtime credentials (use GitHub Actions secrets in production)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2025-01
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token
# Legacy fallback still supported by the sync runner:
SHOPIFY_API_TOKEN=your_legacy_shopify_admin_access_token

SELLVIA_MASTER_KEY=your_sellvia_master_key
# Legacy/new secret names are both supported by the sync runner:
SELLVIA_API_KEY=your_sellvia_api_key
SELLVIA_API_BASE_URL=https://api.sellvia.com
SELLVIA_CATALOG_ENDPOINT=/catalog/products
# Optional and intentionally disabled by default until account-specific contracts are confirmed:
SELLVIA_ORDER_ENDPOINT=

# Safety controls
SHOPIFY_SELLVIA_WRITE_APPROVED=false
SHOPIFY_SELLVIA_PUBLISH_PRODUCTS=false
SHOPIFY_SELLVIA_ENABLE_ORDER_SYNC=false
SHOPIFY_LOCATION_ID=
SYNC_SCOPE=all
SYNC_DRY_RUN=true
SYNC_MAX_RUNTIME_MS=900000
SYNC_REQUEST_TIMEOUT_MS=15000
SYNC_MAX_ATTEMPTS=4
SYNC_RETRY_DELAY_MS=1000

# Optional local-only dry-run fixture path for validation/tests
SELLVIA_CATALOG_FIXTURE_PATH=
SHOPIFY_PRODUCTS_FIXTURE_PATH=
